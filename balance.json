{
  "mapFile": "map.png",

  "canvas": {
    "width": 640,
    "height": 480,
    "background": "#1a0f08"
  },

  "timing": {
    "maxFrameDt": 0.05
  },

  "teams": [
    { "name": "Player 1", "short": "P1", "color": "#ffffff", "spawnX": 70, "queenX": 70, "facing": 1 },
    { "name": "Player 2", "short": "P2", "color": "#e8392b", "spawnX": 570, "queenX": 570, "facing": -1 }
  ],

  "turns": {
    "dronesPerAP": 5,
    "announceDuration": 2,
    "settleDelay": 0.5,
    "gameOverDelay": 0.75
  },

  "winScreen": {
    "restartKey": "Enter",
    "drawText": "Draw",
    "font": "28px monospace",
    "lineHeight": 36,
    "promptGap": 14
  },

  "hud": {
    "font": "10px monospace",
    "announceFont": "16px monospace",
    "color": "#ffffff",
    "margin": 4,
    "lineHeight": 12,
    "announceLineHeight": 22,
    "panelColor": "#1a0f08",
    "panelOpacity": 0.75,
    "inactiveOpacity": 0.65,
    "occludedOpacity": 0.3,
    "rowGap": 2,
    "itemGap": 6,
    "token": { "radius": 3, "spacing": 2 },
    "walkBar": { "width": 40, "height": 5, "backColor": "#000000", "backOpacity": 0.6 },
    "turnOverText": "turn over..."
  },

  "title": {
    "text": "Termites",
    "font": "bold 48px monospace",
    "subtitle": "Two players, one keyboard. Destroy the enemy queen!",
    "headingFont": "12px monospace",
    "promptText": "press any key",
    "promptFont": "14px monospace",
    "blinkPeriod": 1.0,
    "panelWidth": 440,
    "panelHeight": 300,
    "panelOpacity": 0.85,
    "columnGap": 210,
    "spriteScale": 2
  },

  "controls": {
    "p1": { "left": "KeyA", "right": "KeyD", "faceUp": "KeyW", "faceDown": "KeyS", "mode": "KeyQ", "fire": "KeyE", "endTurn": "KeyR" },
    "p2": { "left": "ArrowLeft", "right": "ArrowRight", "faceUp": "ArrowUp", "faceDown": "ArrowDown", "mode": "Slash", "fire": "Period", "endTurn": "Comma" }
  },

  "soldier": {
    "width": 12,
    "height": 24,
    "walkSpeed": 40,
    "walkPxPerAP": 40,
    "walkAPCost": 1,
    "stepUpPx": 3,
    "snapDownPx": 4,
    "gravity": 600,
    "maxFallSpeed": 400,
    "hitsToKill": 1,
    "walkFrameDistance": 4,
    "walkAnimHold": 0.1,
    "aimMidAngle": 25,
    "aimHighAngle": 60
  },

  "queen": {
    "width": 64,
    "height": 64,
    "hitsToKill": 3,
    "spawnScanY": 360,
    "gravity": 600,
    "maxFallSpeed": 400,
    "dots": { "radius": 3, "spacing": 4, "gap": 4 }
  },

  "drone": {
    "width": 12,
    "height": 4,
    "speed": 5,
    "digRadius": 8,
    "bodyRadius": 2,
    "touchMargin": 1.5,
    "edgeMargin": 6,
    "turnRate": 30,
    "turnInterval": 1.5,
    "centerPull": 4,
    "surfaceDigChance": 0.15,
    "digSpread": 70,
    "reverseJitter": 30,
    "walkSearchStep": 15,
    "gravity": 600,
    "maxFallSpeed": 400,
    "startCount": 5,
    "spawnPerTurn": 5,
    "cap": 50,
    "spawnSpread": 24,
    "legFrameDistance": 2
  },

  "death": {
    "skullTime": 1.0,
    "corpseOpacity": 0.55,
    "skullOutlineColor": "#1a0f08",
    "skullScale": { "drone": 1, "soldier": 1, "queen": 3 }
  },

  "sprites": {
    "drone":   { "file": "sprites/drone.png",   "frameWidth": 12, "frameHeight": 4,  "frames": ["walk1", "walk2"] },
    "soldier": { "file": "sprites/soldier.png", "frameWidth": 12, "frameHeight": 24, "frames": ["idle", "walk1", "walk2", "aimMid", "aimHigh"] },
    "queen":   { "file": "sprites/queen.png",   "frameWidth": 64, "frameHeight": 64, "frames": ["idle"] },
    "skull":   { "file": "sprites/skull.png",   "frameWidth": 7,  "frameHeight": 7,  "frames": ["skull"] },
    "cursor":  { "file": "sprites/cursor.png",  "frameWidth": 5,  "frameHeight": 5,  "frames": ["cursor"] }
  },

  "shot": {
    "apCost": 1,
    "startAngle": 45,
    "aimSpeed": 60,
    "aimArcRadius": 22,
    "powerSweepSpeed": 1.25,
    "minSpeed": 80,
    "maxSpeed": 460,
    "gravity": 300,
    "subStepPx": 0.5,
    "maxFlightTime": 15,
    "size": 3,
    "powerBar": {
      "width": 4,
      "height": 32,
      "gap": 4,
      "markerColor": "#ffffff",
      "bottomColor": "#3fbf3f",
      "middleColor": "#f2d22e",
      "topColor": "#e8392b",
      "labelColor": "#ffffff",
      "font": "8px monospace"
    }
  },

  "grid": {
    "spacing": 40,
    "color": "#ffffff",
    "opacity": 0.08
  },

  "explosion": {
    "minRadius": 5,
    "maxRadius": 100,
    "ringDuration": 0.45,
    "ringBlock": 3,
    "ringColor": "#ffe9a8",
    "particleCount": 14,
    "particleSpeed": 110,
    "particleGravity": 400,
    "particleLife": 0.6,
    "particleSize": 3,
    "particleSpread": 0.5
  },

  "debug": {
    "clickToExplode": false,
    "clickExplosionRadius": 40,
    "radiusStep": 5,
    "color": "#ffffff",
    "circleOpacity": 0.35,
    "font": "10px monospace"
  },

  "terrainKey": [
    { "type": "open",    "color": "#2b1a0e", "solid": false, "resistance": 0 },
    { "type": "soft",    "color": "#9a6a3c", "solid": true,  "resistance": 1 },
    { "type": "medium",  "color": "#845a32", "solid": true,  "resistance": 0.75 },
    { "type": "hard",    "color": "#6e4a29", "solid": true,  "resistance": 0.5 },
    { "type": "bedrock", "color": "#4a4440", "solid": true,  "resistance": 0 }
  ],

  "mapGenerator": {
    "seed": 1337,
    "surfaceY": 150,
    "hillAmplitude": 55,
    "hillWaves": 3,
    "flatEdgeWidth": 130,
    "softMediumY": 250,
    "mediumHardY": 345,
    "bandWaveAmplitude": 12,
    "bedrockHeight": 8,
    "chamberWidth": 84,
    "chamberHeight": 76,
    "chamberEdgeMargin": 28,
    "chamberFloorY": 400
  }
}

{
  "mapFile": "map.png",

  "canvas": {
    "width": 640,
    "height": 480,
    "background": "#1a0f08"
  },

  "timing": {
    "maxFrameDt": 0.05
  },

  "teams": [
    { "name": "Player 1", "color": "#ffffff", "spawnX": 70, "facing": 1 },
    { "name": "Player 2", "color": "#e8392b", "spawnX": 570, "facing": -1 }
  ],

  "turns": {
    "fixedAP": 2,
    "announceDuration": 2,
    "settleDelay": 0.5
  },

  "hud": {
    "font": "10px monospace",
    "announceFont": "16px monospace",
    "color": "#ffffff",
    "margin": 4,
    "lineHeight": 12,
    "announceLineHeight": 22,
    "panelColor": "#1a0f08",
    "panelOpacity": 0.75,
    "inactiveOpacity": 0.5
  },

  "controls": {
    "p1": { "left": "KeyA", "right": "KeyD", "faceUp": "KeyW", "faceDown": "KeyS", "mode": "KeyQ", "fire": "KeyE", "endTurn": "KeyR" },
    "p2": { "left": "ArrowLeft", "right": "ArrowRight", "faceUp": "ArrowUp", "faceDown": "ArrowDown", "mode": "Slash", "fire": "Period", "endTurn": "Comma" }
  },

  "soldier": {
    "width": 12,
    "height": 24,
    "walkSpeed": 40,
    "walkPxPerAP": 40,
    "walkAPCost": 1,
    "stepUpPx": 3,
    "snapDownPx": 4,
    "gravity": 600,
    "maxFallSpeed": 400,
    "hitsToKill": 1,
    "eyeColor": "#1a0f08"
  },

  "shot": {
    "apCost": 1,
    "startAngle": 45,
    "aimSpeed": 60,
    "aimArcRadius": 22,
    "powerSweepSpeed": 1.25,
    "minSpeed": 80,
    "maxSpeed": 460,
    "gravity": 300,
    "subStepPx": 0.5,
    "maxFlightTime": 15,
    "size": 3,
    "powerBar": {
      "width": 4,
      "height": 32,
      "gap": 4,
      "markerColor": "#ffffff",
      "bottomColor": "#3fbf3f",
      "middleColor": "#f2d22e",
      "topColor": "#e8392b",
      "labelColor": "#ffffff",
      "font": "8px monospace"
    }
  },

  "grid": {
    "spacing": 40,
    "color": "#ffffff",
    "opacity": 0.08
  },

  "explosion": {
    "minRadius": 5,
    "maxRadius": 100,
    "ringDuration": 0.45,
    "ringBlock": 3,
    "ringColor": "#ffe9a8",
    "particleCount": 10,
    "particleSpeed": 110,
    "particleGravity": 400,
    "particleLife": 0.6,
    "particleSize": 2
  },

  "debug": {
    "clickToExplode": true,
    "clickExplosionRadius": 40,
    "radiusStep": 5,
    "color": "#ffffff",
    "circleOpacity": 0.35,
    "font": "10px monospace",
    "respawnDelay": 1.5
  },

  "terrainKey": [
    { "type": "open",    "color": "#2b1a0e", "solid": false, "resistance": 0 },
    { "type": "soft",    "color": "#9a6a3c", "solid": true,  "resistance": 1 },
    { "type": "medium",  "color": "#845a32", "solid": true,  "resistance": 0.75 },
    { "type": "hard",    "color": "#6e4a29", "solid": true,  "resistance": 0.5 },
    { "type": "bedrock", "color": "#4a4440", "solid": true,  "resistance": 0 }
  ],

  "mapGenerator": {
    "seed": 1337,
    "surfaceY": 150,
    "hillAmplitude": 55,
    "hillWaves": 3,
    "flatEdgeWidth": 130,
    "softMediumY": 250,
    "mediumHardY": 345,
    "bandWaveAmplitude": 12,
    "bedrockHeight": 8,
    "chamberWidth": 84,
    "chamberHeight": 76,
    "chamberEdgeMargin": 28,
    "chamberFloorY": 400
  }
}
